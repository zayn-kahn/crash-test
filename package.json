{
  "name": "crash-test",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "forge build --root contracts",
    "test:contracts": "forge test --root contracts",
    "test:brake": "forge test --root contracts/lib/brake/contracts/brake",
    "check:wallets": "forge build --root contracts && tsx scripts/check-wallets.ts",
    "check:scenarios": "forge build --root contracts && tsx scripts/check-scenarios.ts",
    "sim": "forge build --root contracts && tsx scripts/sim.ts",
    "study": "forge build --root contracts && tsx scripts/study.ts",
    "judge": "tsx scripts/judge.ts",
    "analyze": "tsx scripts/analyze.ts",
    "label:sample": "tsx scripts/label-sample.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "web": "vite --config web/vite.config.ts",
    "models": "tsx scripts/models.ts",
    "check:openrouter": "tsx scripts/check-openrouter.ts",
    "clean": "tsx scripts/clean.ts",
    "export:hf": "tsx scripts/export-hf.ts"
  },
  "packageManager": "pnpm@9.6.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
